#!/usr/bin/env bash
# Avant chaque push : si l'appli Windows (windows-native/) change, toute sa suite de tests passe,
# dont la lecture de bout en bout sur le serveur Jellyfin de test (windows-native/tests/server.env,
# local ; tests ignorés si le fichier manque ou si le serveur est injoignable). Push bloqué au moindre échec.
#
# Activé une fois par clone : git config core.hooksPath .githooks   (contourner : git push --no-verify)
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
changed=""
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  else
    base=$remote_sha
  fi
  if [ -n "$base" ]; then range="$base..$local_sha"; else range="$local_sha"; fi
  changed+=$(git diff --name-only "$range" -- windows-native 2>/dev/null)
done
[ -z "$changed" ] && exit 0

export PATH="/c/Program Files/dotnet:$PATH"
echo "pre-push : appli Windows modifiée, tests en cours (lecture, formats, serveur de test)…"
log=$(mktemp)
# Suivi en direct : titre en cours sur le serveur de test et tests en échec, au fil de l'eau.
dotnet run --project windows-native/tests/OptiFin.Core.Tests -c Release 2>&1 | tee "$log" | grep --line-buffered -aE "\[serveur |\[FAIL\]"
status=${PIPESTATUS[0]}
echo "—"
grep -aE "\[FAIL\]|\[SKIP\]|^\s{6}[^ ]|Total:" "$log" | grep -v "Stack Trace" | head -60
if [ $status -ne 0 ] || grep -aq "\[FAIL\]" "$log"; then
  echo "pre-push : tests en échec, push annulé (journal complet : $log)."
  exit 1
fi
rm -f "$log"
echo "pre-push : tests OK."
