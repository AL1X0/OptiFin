<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Lecteur vidéo d'OptiFin pour Windows : libmpv (rendu gpu-next / libplacebo sur Direct3D 11,
    décodage matériel D3D11VA, HDR10 / HLG / Dolby Vision transmis à un écran HDR).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>OptiFin.Mpv</RootNamespace>
  </PropertyGroup>

  <!--
    libmpv : compilation shinchiro 20260928 (git e470f8986e) figée, téléchargée une seule fois dans un
    cache partagé, jamais versionnée (120 Mo). L'amont a retiré cette version (404) : la DLL, celle livrée
    depuis la 1.1.22, est hébergée dans la release « deps-libmpv-20260928 » du dépôt, et son empreinte
    SHA-256 est vérifiée avant usage.
  -->
  <PropertyGroup>
    <LibmpvUrl>https://github.com/AL1X0/OptiFin/releases/download/deps-libmpv-20260928/libmpv-2.dll</LibmpvUrl>
    <LibmpvSha256>0D5B9DBECB73E179EF39DC94314FF8905FAB926A80F8D60A2367D824B7254E2E</LibmpvSha256>
    <LibmpvDir>$(LocalAppData)\OptiFin-build\libmpv-20260928</LibmpvDir>
  </PropertyGroup>

  <Target Name="FetchLibmpv" BeforeTargets="BeforeBuild;AssignTargetPaths" Condition="!Exists('$(LibmpvDir)\libmpv-2.dll')">
    <Message Importance="high" Text="OptiFin : téléchargement de libmpv (deps-libmpv-20260928)" />
    <MakeDir Directories="$(LibmpvDir)" />
    <!-- Téléchargée sous un nom temporaire : une DLL à l'empreinte inattendue n'est jamais utilisée. -->
    <DownloadFile SourceUrl="$(LibmpvUrl)" DestinationFolder="$(LibmpvDir)" DestinationFileName="libmpv-2.dll.part" Retries="3" />
    <GetFileHash Files="$(LibmpvDir)\libmpv-2.dll.part" Algorithm="SHA256">
      <Output TaskParameter="Hash" PropertyName="LibmpvActualSha256" />
    </GetFileHash>
    <Delete Files="$(LibmpvDir)\libmpv-2.dll.part" Condition="'$(LibmpvActualSha256)' != '$(LibmpvSha256)'" />
    <Error Condition="'$(LibmpvActualSha256)' != '$(LibmpvSha256)'"
           Text="libmpv : empreinte inattendue ($(LibmpvActualSha256)) — téléchargement refusé." />
    <Move SourceFiles="$(LibmpvDir)\libmpv-2.dll.part" DestinationFiles="$(LibmpvDir)\libmpv-2.dll" />
  </Target>

  <!--
    Chargeur Vulkan officiel (Khronos) : libmpv-2.dll en dépend à son chargement, même si le rendu passe par
    Direct3D 11, et Windows ne le fournit pas (il vient des pilotes graphiques) : sans lui, pas de lecteur.
  -->
  <ItemGroup>
    <PackageReference Include="Silk.NET.Vulkan.Loader.Native" Version="2025.9.12" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(LibmpvDir)\libmpv-2.dll" Link="libmpv-2.dll" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
