<?xml version="1.0" encoding="utf-8"?>
<!--
  Identité OptiFin (même univers que sur iPhone, Android et TV) : fond noir, texte blanc,
  accent bleu, cartes arrondies, verre dépoli.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="OFBackground">#FF000000</Color>
    <Color x:Key="OFSurface">#FF121214</Color>
    <Color x:Key="OFSurfaceRaised">#FF1C1C1E</Color>
    <Color x:Key="OFSidebar">#FF0B0B0D</Color>
    <Color x:Key="OFStroke">#14FFFFFF</Color>
    <Color x:Key="OFTextPrimary">#FFF2F2F7</Color>
    <Color x:Key="OFTextSecondary">#B3EBEBF5</Color>
    <Color x:Key="OFTextTertiary">#66EBEBF5</Color>
    <Color x:Key="OFAccent">#FF4DA3FF</Color>
    <Color x:Key="OFDanger">#FFFF453A</Color>
    <Color x:Key="OFGlass">#8C1C1C1E</Color>

    <SolidColorBrush x:Key="OFBackgroundBrush" Color="{StaticResource OFBackground}" />
    <SolidColorBrush x:Key="OFSurfaceBrush" Color="{StaticResource OFSurface}" />
    <SolidColorBrush x:Key="OFSurfaceRaisedBrush" Color="{StaticResource OFSurfaceRaised}" />
    <SolidColorBrush x:Key="OFSidebarBrush" Color="{StaticResource OFSidebar}" />
    <SolidColorBrush x:Key="OFStrokeBrush" Color="{StaticResource OFStroke}" />
    <SolidColorBrush x:Key="OFTextPrimaryBrush" Color="{StaticResource OFTextPrimary}" />
    <SolidColorBrush x:Key="OFTextSecondaryBrush" Color="{StaticResource OFTextSecondary}" />
    <SolidColorBrush x:Key="OFTextTertiaryBrush" Color="{StaticResource OFTextTertiary}" />
    <SolidColorBrush x:Key="OFAccentBrush" Color="{StaticResource OFAccent}" />
    <SolidColorBrush x:Key="OFDangerBrush" Color="{StaticResource OFDanger}" />
    <SolidColorBrush x:Key="OFGlassBrush" Color="{StaticResource OFGlass}" />

    <!-- Accent de Windows remplacé par celui d'OptiFin. -->
    <Color x:Key="SystemAccentColor">#FF4DA3FF</Color>
    <Color x:Key="SystemAccentColorLight1">#FF6FB5FF</Color>
    <Color x:Key="SystemAccentColorLight2">#FF92C7FF</Color>
    <Color x:Key="SystemAccentColorDark1">#FF3A8EE6</Color>

    <x:Double x:Key="OFGutter">40</x:Double>
    <CornerRadius x:Key="OFRadiusCard">12</CornerRadius>
    <CornerRadius x:Key="OFRadiusPill">999</CornerRadius>

    <Style x:Key="OFDisplay" TargetType="TextBlock">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource OFTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="OFTitle1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource OFTextPrimaryBrush}" />
    </Style>
    <Style x:Key="OFTitle2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource OFTextPrimaryBrush}" />
    </Style>
    <Style x:Key="OFBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource OFTextPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="OFCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource OFTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Bouton principal : pilule blanche, texte noir (comme « Lecture » sur mobile). -->
    <Style x:Key="OFPrimaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="{StaticResource OFTextPrimaryBrush}" />
        <Setter Property="Foreground" Value="#FF000000" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="OFSecondaryButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="#33FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource OFTextPrimaryBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style x:Key="OFIconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="Foreground" Value="{StaticResource OFTextPrimaryBrush}" />
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
</ResourceDictionary>
