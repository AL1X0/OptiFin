<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OptiFin.App.Player.PlayerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OptiFin">
    <!-- Fenêtre des commandes, transparente, au-dessus de la fenêtre vidéo de mpv. -->
    <Grid x:Name="Root" Background="Transparent">
        <Grid x:Name="Surface" Background="#01000000" />

        <!-- Préparation / mise en mémoire tampon -->
        <Grid x:Name="Preparing" Background="#FF000000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18">
                <ProgressRing IsActive="True" Width="44" Height="44" Foreground="White" />
                <TextBlock x:Name="PreparingTitle" Style="{StaticResource OFTitle2}" HorizontalAlignment="Center" />
                <TextBlock x:Name="Notice" Style="{StaticResource OFCaption}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
        <ProgressRing x:Name="Buffering" IsActive="False" Width="48" Height="48" Foreground="White" IsHitTestVisible="False" />

        <!-- Commandes -->
        <Grid x:Name="Controls" Opacity="1">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.25" />
            </Grid.OpacityTransition>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Voiles haut et bas : lisibilité sur toute image. -->
            <Border Grid.RowSpan="3" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#99000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="0.22" />
                        <GradientStop Color="#00000000" Offset="0.62" />
                        <GradientStop Color="#CC000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Grid x:Name="TopBar" Padding="20,16,20,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="CloseButton" Style="{StaticResource OFIconButton}" Background="{StaticResource OFGlassBrush}"
                        ToolTipService.ToolTip="Fermer (Échap)">
                    <FontIcon Glyph="&#xE72B;" FontSize="16" />
                </Button>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource OFCaption}" />
                </StackPanel>
                <!-- Soirée en cours : nom, participants, attente du groupe. -->
                <Border x:Name="PartyBadge" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center" CornerRadius="18"
                        Padding="12,7,14,7" Background="{StaticResource OFGlassBrush}" BorderBrush="#33FFFFFF" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE716;" FontSize="14" Foreground="{StaticResource OFAccentBrush}" />
                        <TextBlock x:Name="PartyText" FontSize="13" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>

            <StackPanel x:Name="Center" Grid.Row="1" Orientation="Horizontal" Spacing="40" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BackButton" Width="64" Height="64" Background="Transparent" BorderThickness="0" CornerRadius="32"
                        ToolTipService.ToolTip="Reculer de 10 s (←)">
                    <FontIcon Glyph="&#xEB9E;" FontSize="30" />
                </Button>
                <Button x:Name="PlayButton" Width="88" Height="88" Background="Transparent" BorderThickness="0" CornerRadius="44"
                        ToolTipService.ToolTip="Lecture / pause (Espace)">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE769;" FontSize="48" />
                </Button>
                <Button x:Name="ForwardButton" Width="64" Height="64" Background="Transparent" BorderThickness="0" CornerRadius="32"
                        ToolTipService.ToolTip="Avancer de 10 s (→)">
                    <FontIcon Glyph="&#xEB9D;" FontSize="30" />
                </Button>
            </StackPanel>

            <!-- Bas : chapitre et heure de fin, puis temps, barre de lecture et boutons sur une ligne. -->
            <StackPanel Grid.Row="2" Padding="24,0,20,18" Spacing="4">
                <Grid Margin="2,0,2,0">
                    <TextBlock x:Name="ChapterText" Style="{StaticResource OFCaption}" HorizontalAlignment="Left" />
                    <TextBlock x:Name="EndsAtText" Style="{StaticResource OFCaption}" HorizontalAlignment="Right" Foreground="{StaticResource OFTextTertiaryBrush}" />
                </Grid>
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PositionText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="52" TextAlignment="Right" />
                    <Grid x:Name="Scrubber" Grid.Column="1" Height="28" Background="Transparent">
                        <Border x:Name="Track" Height="5" CornerRadius="3" Background="#33FFFFFF" VerticalAlignment="Center" />
                        <Border x:Name="BufferedBar" Height="5" CornerRadius="3" Background="#40FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                        <Border x:Name="PlayedBar" Height="5" CornerRadius="3" Background="#F2FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Width="0" />
                        <Border x:Name="HoverLabel" Background="#E6000000" CornerRadius="6" Padding="8,3,8,3" HorizontalAlignment="Left"
                                VerticalAlignment="Top" Margin="0,-30,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="HoverText" FontSize="12" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                    <TextBlock x:Name="RemainingText" Grid.Column="2" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="52"
                               Foreground="{StaticResource OFTextSecondaryBrush}" />
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Padding="4" CornerRadius="24"
                                Background="{StaticResource OFGlassBrush}" VerticalAlignment="Center">
                        <Button x:Name="AudioButton" Style="{StaticResource OFIconButton}" Width="40" Height="40" Background="Transparent" ToolTipService.ToolTip="Audio">
                            <FontIcon Glyph="&#xE8D6;" FontSize="16" />
                        </Button>
                        <Button x:Name="SubtitlesButton" Style="{StaticResource OFIconButton}" Width="40" Height="40" Background="Transparent" ToolTipService.ToolTip="Sous-titres">
                            <FontIcon Glyph="&#xED1E;" FontSize="16" />
                        </Button>
                        <Button x:Name="SettingsButton" Style="{StaticResource OFIconButton}" Width="40" Height="40" Background="Transparent" ToolTipService.ToolTip="Réglages">
                            <FontIcon Glyph="&#xE713;" FontSize="16" />
                        </Button>
                        <Button x:Name="InfoButton" Style="{StaticResource OFIconButton}" Width="40" Height="40" Background="Transparent" ToolTipService.ToolTip="Infos de lecture (I)">
                            <FontIcon x:Name="InfoIcon" Glyph="&#xE946;" FontSize="16" />
                        </Button>
                        <Button x:Name="FullscreenButton" Style="{StaticResource OFIconButton}" Width="40" Height="40" Background="Transparent" ToolTipService.ToolTip="Plein écran (F)">
                            <FontIcon x:Name="FullscreenIcon" Glyph="&#xE740;" FontSize="16" />
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Indicateurs et cartes -->
        <Border x:Name="Level" Background="#CC1C1C1E" CornerRadius="16" Padding="18,10,18,10" HorizontalAlignment="Center"
                VerticalAlignment="Top" Margin="0,90,0,0" Opacity="0" IsHitTestVisible="False">
            <Border.OpacityTransition>
                <ScalarTransition Duration="0:0:0.2" />
            </Border.OpacityTransition>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <FontIcon x:Name="LevelIcon" Glyph="&#xE767;" FontSize="18" />
                <ProgressBar x:Name="LevelBar" Width="140" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
        <Button x:Name="SkipButton" Style="{StaticResource OFPrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,32,120" Visibility="Collapsed" />
        <Grid x:Name="UpNext" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,120" Visibility="Collapsed"
              Width="360" Padding="14" CornerRadius="16" Background="#E61C1C1E" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="ÉPISODE SUIVANT" FontSize="11" FontWeight="SemiBold" CharacterSpacing="100" Foreground="{StaticResource OFTextTertiaryBrush}" />
                <TextBlock x:Name="UpNextTitle" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="UpNextPlay" Style="{StaticResource OFPrimaryButton}" Content="Lire" />
                <Button x:Name="UpNextDismiss" Style="{StaticResource OFSecondaryButton}" Content="Continuer le générique" />
            </StackPanel>
        </Grid>

        <!-- Infos de lecture (mode débogage ou bouton « i ») -->
        <Border x:Name="StatsPanel" Background="#D9101012" CornerRadius="14" Padding="16,12,16,14" Margin="20,84,0,0"
                HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="#26FFFFFF" BorderThickness="1"
                Visibility="Collapsed" IsHitTestVisible="False" MinWidth="340">
            <Grid x:Name="StatsGrid" ColumnSpacing="14" RowSpacing="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
            </Grid>
        </Border>

        <!-- Erreur -->
        <Grid x:Name="ErrorPanel" Background="#FF000000" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="560">
                <FontIcon Glyph="&#xE7BA;" FontSize="36" Foreground="{StaticResource OFDangerBrush}" />
                <TextBlock x:Name="ErrorText" Style="{StaticResource OFTitle2}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="ErrorDetail" Style="{StaticResource OFCaption}" TextAlignment="Center" TextWrapping="Wrap" MaxLines="6" />
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                    <Button x:Name="ErrorClose" Style="{StaticResource OFPrimaryButton}" Content="Fermer" />
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Rideau noir : fondu de sortie du lecteur. -->
        <Grid x:Name="Curtain" Background="#FF000000" Opacity="0" IsHitTestVisible="False">
            <Grid.OpacityTransition>
                <ScalarTransition Duration="0:0:0.28" />
            </Grid.OpacityTransition>
        </Grid>
    </Grid>
</Window>
