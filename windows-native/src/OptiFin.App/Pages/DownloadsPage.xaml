<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OptiFin.App.Pages.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="48,96,48,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Téléchargements" Style="{StaticResource OFTitle1}" Margin="0,0,0,24" />
        <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Rows" Spacing="12" Padding="0,0,0,48" MaxWidth="1000" HorizontalAlignment="Left" />
        </ScrollViewer>
        <StackPanel x:Name="UndoBanners" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,24" Spacing="8" />
    </Grid>
</Page>
