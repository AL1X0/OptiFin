<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OptiFin.App.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF000000">
    <!-- Écran d'accueil : fond animé (ajouté en code), logo, titre, carte en verre. -->
    <Grid x:Name="RootGrid">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Column" MaxWidth="460" Padding="24,64,24,48" VerticalAlignment="Center" Spacing="8">
                <StackPanel.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="36" />
                    </TransitionCollection>
                </StackPanel.ChildrenTransitions>
                <TextBlock x:Name="ServerName" Style="{StaticResource OFDisplay}" FontSize="38" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="Subtitle" Text="Qui regarde ?" FontSize="16" Foreground="{StaticResource OFTextSecondaryBrush}"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="ServerInfo" Style="{StaticResource OFCaption}" HorizontalAlignment="Center"
                           Foreground="{StaticResource OFTextTertiaryBrush}" />
                <Border CornerRadius="24" Padding="24,22,24,24" Margin="0,20,0,0" Background="#12FFFFFF"
                        BorderBrush="#22FFFFFF" BorderThickness="1">
                    <StackPanel x:Name="Form" Spacing="10" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
