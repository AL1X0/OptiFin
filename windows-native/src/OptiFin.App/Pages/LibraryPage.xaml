<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OptiFin.App.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Enabled">
    <Grid Padding="48,56,32,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="56,0,0,16">
            <TextBlock x:Name="Title" Style="{StaticResource OFTitle1}" />
            <TextBlock x:Name="Count" Style="{StaticResource OFCaption}" VerticalAlignment="Bottom" Margin="0,0,0,6" />
        </StackPanel>
        <StackPanel x:Name="Toolbar" Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="0,0,0,16" />
        <GridView x:Name="Items" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="False" Padding="0,0,0,48"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <ContentControl />
                </DataTemplate>
            </GridView.ItemTemplate>
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,16,20" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="IsTabStop" Value="False" />
                </Style>
            </GridView.ItemContainerStyle>
        </GridView>
        <ProgressRing x:Name="Spinner" Grid.Row="2" IsActive="True" Width="40" Height="40" />
        <TextBlock x:Name="Empty" Grid.Row="2" Visibility="Collapsed" Style="{StaticResource OFBody}"
                   Foreground="{StaticResource OFTextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
