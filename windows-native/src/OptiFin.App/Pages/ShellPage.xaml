<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OptiFin.App.Pages.ShellPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource OFBackgroundBrush}">
    <Grid>
        <!-- Contenu plein cadre : l'image à la une passe sous la barre du haut. -->
        <Frame x:Name="ContentFrame" />

        <!-- Barre du haut, intégrée à la barre de titre de la fenêtre. -->
        <Grid x:Name="TopBar" Height="72" VerticalAlignment="Top">
            <!-- Fond : voile dégradé sur l'image, opaque une fois la page défilée. -->
            <Border IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#B3000000" Offset="0" />
                        <GradientStop Color="#00000000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            <Border x:Name="SolidBar" Background="#F2060607" BorderBrush="{StaticResource OFStrokeBrush}" BorderThickness="0,0,0,1"
                    Opacity="0" IsHitTestVisible="False">
                <Border.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.25" />
                </Border.OpacityTransition>
            </Border>

            <Grid x:Name="BarContent" Padding="20,0,0,0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="CaptionColumn" Width="140" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Style="{StaticResource OFIconButton}" Width="40" Height="40" Visibility="Collapsed"
                        Background="{StaticResource OFGlassBrush}" VerticalAlignment="Center" ToolTipService.ToolTip="Retour (Alt+←)">
                    <FontIcon Glyph="&#xE72B;" FontSize="15" />
                </Button>

                <!-- Logo OptiFin et serveur connecté. -->
                <StackPanel x:Name="Brand" Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="4,0,20,0">
                    <Border Width="38" Height="38" CornerRadius="11" BorderThickness="1" BorderBrush="{StaticResource OFStrokeBrush}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FF26262A" Offset="0" />
                                <GradientStop Color="#FF0A0A0C" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image x:Name="Logo" Width="23" Height="23" />
                    </Border>
                    <TextBlock x:Name="ServerName" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                               MaxWidth="220" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Rubriques -->
                <StackPanel x:Name="Tabs" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />

                <!-- Zone de déplacement de la fenêtre -->
                <Grid x:Name="DragArea" Grid.Column="3" Background="Transparent" />

                <!-- Recherche dans toutes les bibliothèques (Ctrl+F). -->
                <Grid x:Name="SearchBox" Grid.Column="4" Width="280" Height="40" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBox x:Name="SearchInput" PlaceholderText="Rechercher un titre, une personne…" CornerRadius="20"
                             Padding="40,9,36,0" FontSize="14" BorderThickness="1" />
                    <FontIcon Glyph="&#xE721;" FontSize="14" HorizontalAlignment="Left" Margin="15,0,0,0" IsHitTestVisible="False"
                              Foreground="{StaticResource OFTextSecondaryBrush}" />
                    <Button x:Name="SearchClear" HorizontalAlignment="Right" Width="32" Height="32" Margin="0,0,4,0" Padding="0"
                            CornerRadius="16" Background="Transparent" BorderThickness="0" Visibility="Collapsed" ToolTipService.ToolTip="Effacer">
                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                    </Button>
                </Grid>

                <!-- Soirées (SyncPlay) -->
                <Button x:Name="PartyButton" Grid.Column="5" Height="40" Padding="12,0,14,0" CornerRadius="20" Margin="0,0,10,0"
                        VerticalAlignment="Center" Background="{StaticResource OFGlassBrush}" BorderThickness="1" BorderBrush="Transparent"
                        ToolTipService.ToolTip="Soirée : regarder ensemble">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon x:Name="PartyIcon" Glyph="&#xE716;" FontSize="15" />
                        <TextBlock x:Name="PartyLabel" Text="Soirée" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Profil : réglages, changement de compte, déconnexion. -->
                <Button x:Name="ProfileButton" Grid.Column="6" Padding="4,4,12,4" CornerRadius="22" VerticalAlignment="Center"
                        Background="{StaticResource OFGlassBrush}" BorderThickness="0">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Border x:Name="AvatarHost" Width="32" Height="32" />
                        <TextBlock x:Name="UserName" VerticalAlignment="Center" FontSize="14" />
                        <FontIcon Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" Foreground="{StaticResource OFTextSecondaryBrush}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Annonces (soirée…) en bas à droite. -->
        <StackPanel x:Name="Notices" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" Spacing="8">
            <StackPanel.ChildrenTransitions>
                <TransitionCollection>
                    <EntranceThemeTransition FromHorizontalOffset="40" FromVerticalOffset="0" />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </StackPanel.ChildrenTransitions>
        </StackPanel>
    </Grid>
</Page>
