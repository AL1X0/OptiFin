<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OptiFin.App.Pages.LibrariesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Padding="48,96,48,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Bibliothèques" Style="{StaticResource OFTitle1}" Margin="0,0,0,24" />
        <ScrollViewer x:Name="Scroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <VariableSizedWrapGrid x:Name="Grid" Orientation="Horizontal" ItemWidth="336" ItemHeight="236">
                <VariableSizedWrapGrid.ChildrenTransitions>
                    <TransitionCollection>
                        <EntranceThemeTransition IsStaggeringEnabled="True" FromVerticalOffset="40" />
                    </TransitionCollection>
                </VariableSizedWrapGrid.ChildrenTransitions>
            </VariableSizedWrapGrid>
        </ScrollViewer>
        <ProgressRing x:Name="Spinner" Grid.Row="1" IsActive="True" Width="40" Height="40" />
    </Grid>
</Page>
