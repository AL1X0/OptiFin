<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="OptiFin.App.Pages.DetailsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="Body" Spacing="32" Padding="0,0,0,56" />
        </ScrollViewer>
        <ProgressRing x:Name="Spinner" IsActive="True" Width="40" Height="40" />
        <TextBlock x:Name="ErrorText" Visibility="Collapsed" Style="{StaticResource OFBody}" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Page>
