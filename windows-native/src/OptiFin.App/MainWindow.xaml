<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="OptiFin.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="OptiFin">
    <Grid x:Name="Root" Background="{StaticResource OFBackgroundBrush}">
        <Frame x:Name="RootFrame" />
        <!-- Barre de titre intégrée : zone de déplacement de la fenêtre (les boutons de Windows restent à droite). -->
        <Grid x:Name="TitleBar" Height="40" VerticalAlignment="Top" Background="Transparent" />
    </Grid>
</Window>
